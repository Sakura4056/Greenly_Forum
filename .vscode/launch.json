{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "PlantBackendApplication",
            "request": "launch",
            "mainClass": "com.plant.backend.PlantBackendApplication",
            "projectName": "plant-backend",
            "cwd": "${workspaceFolder}/plant-backend",
            "envFile": "${workspaceFolder}/plant-backend/.env"
        },
        {
            "name": "Launch via NPM",
            "request": "launch",
            "runtimeArgs": [
                "run-script",
                "debug"
            ],
            "runtimeExecutable": "npm",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "type": "msedge",
            "request": "launch",
            "name": "启动 Edge 浏览器（localhost:8080）",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "stable",
            "userDataDir": false
        }
    ]
}