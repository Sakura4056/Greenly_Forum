# ===========================================
# Greenly 后端环境变量配置模板
# ===========================================
# 使用说明：
# 1. 复制此文件为 plant-backend/.env（不要提交到版本控制）
#    命令: cp .env.example .env
# 2. 修改对应的值为实际配置
# 3. 启动应用时会自动加载（开发环境）
# 4. 生产环境建议通过系统环境变量或配置中心管理
# ===========================================

# -------------------------------------------
# 数据库配置（必需）
# -------------------------------------------
# MySQL 数据库用户名
DB_USERNAME=root

# MySQL 数据库密码（请设置强密码，至少 12 位）
DB_PASSWORD=your_strong_database_password_here

# MySQL 连接 URL
# 参数说明：
# - useUnicode=true&characterEncoding=utf-8: 使用 UTF-8 编码
# - useSSL=false: 本地开发禁用 SSL（生产环境应启用）
# - serverTimezone=Asia/Shanghai: 时区设置为上海
# - allowPublicKeyRetrieval=true: 允许公钥检索
DB_URL=jdbc:mysql://localhost:3306/greenly_db?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# -------------------------------------------
# Redis 配置（可选，用于缓存和会话管理）
# -------------------------------------------
# Redis 服务器地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码（如果未设置密码则留空）
REDIS_PASSWORD=

# -------------------------------------------
# 邮件配置（必需，用于发送养护提醒）
# -------------------------------------------
# SMTP 服务器地址（以 163 邮箱为例）
MAIL_HOST=smtp.163.com

# SMTP 端口（SSL 加密端口）
MAIL_PORT=465

# 发件人邮箱地址
MAIL_USERNAME=your_email@163.com

# SMTP 授权码（不是邮箱登录密码！）
# 获取方式：登录 163 邮箱 -> 设置 -> POP3/SMTP/IMAP -> 开启 SMTP 服务 -> 生成授权码
MAIL_PASSWORD=your_smtp_authorization_code_here

# -------------------------------------------
# JWT 配置（必需，用于用户认证）
# -------------------------------------------
# JWT 签名密钥（必须至少 32 个字符的随机字符串）
# 建议使用密码生成器生成，例如：https://generate-random.org/
# 示例: openssl rand -hex 32
JWT_SECRET=change_this_to_a_secure_random_string_at_least_32_characters_long_please_use_generator

# -------------------------------------------
# 百度 AI 配置（必需，用于植物识别和健康诊断）
# -------------------------------------------
# 百度智能云应用 ID
# 获取方式：登录 https://console.bce.baidu.com/ai/ -> 创建应用
BAIDU_AI_APP_ID=your_baidu_ai_app_id

# 百度智能云 API Key
BAIDU_AI_API_KEY=your_baidu_ai_api_key

# 百度智能云 Secret Key
BAIDU_AI_SECRET_KEY=your_baidu_ai_secret_key

# -------------------------------------------
# 应用配置（可选，有默认值）
# -------------------------------------------
# 服务器端口（默认 8085）
SERVER_PORT=8085

# 文件上传路径（默认 ./data/uploads/）
FILE_UPLOAD_PATH=./data/uploads/

# -------------------------------------------
# 日志级别配置（可选）
# -------------------------------------------
# 应用日志级别（开发环境建议 DEBUG，生产环境建议 INFO）
LOG_LEVEL_APP=DEBUG

# Spring 框架日志级别
LOG_LEVEL_SPRING=INFO

# -------------------------------------------
# 安全提示
# -------------------------------------------
# 1. 请勿将 .env 文件提交到版本控制系统
# 2. 定期更换敏感凭据（数据库密码、API Key 等）
# 3. 生产环境请使用更安全的配置管理方式（如 Vault、AWS Secrets Manager）
# 4. 确保 .env 文件权限设置为仅所有者可读（chmod 600 .env）
